# ── Railway Keycloak service variables (copy into Railway dashboard) ───────────
# Docs: docs/runbooks/railway-deploy.md

# REQUIRED — health probe port (Keycloak serves /health on 9000, HTTP on 8080)
PORT=9000

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.PGDATABASE}}
KC_DB_USERNAME=${{Postgres.PGUSER}}
KC_DB_PASSWORD=${{Postgres.PGPASSWORD}}
KC_DB_POOL_MAX_SIZE=10

# Full public URL including https:// (use Railway domain first, then custom domain)
KC_HOSTNAME=https://id.dixon.xyz

KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_PROXY_TRUSTED_ADDRESSES=100.64.0.0/10,fd00::/8
KC_HEALTH_ENABLED=true

# Keycloak 26+ bootstrap admin (first boot only — remove after creating permanent admin)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Networking: Railway domain target port = 8080 (Settings → Networking)

# ── WordPress SP (configure in Keycloak admin → Clients → wordpress-vip) ───────
WP_SP_ENTITY_ID=https://your-vip-site.com/
WP_SP_ACS_URL=https://your-vip-site.com/sso/verify
WP_SP_SLO_URL=https://your-vip-site.com/sso/logout
ALLOWED_EMAIL=you@dixon.xyz
