# ── Keycloak (Railway service variables) ─────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/${PGDATABASE}
KC_DB_USERNAME=${PGUSER}
KC_DB_PASSWORD=${PGPASSWORD}

# Public URL — set after custom domain is attached
KC_HOSTNAME=id.dixon.xyz
KC_HOSTNAME_STRICT=true
KC_HOSTNAME_STRICT_HTTPS=true
KC_PROXY=edge
KC_HTTP_ENABLED=true

# ── WordPress SP (used when configuring SAML client in Keycloak admin) ───────
# Entity ID must include trailing slash (wp-simple-saml requirement)
WP_SP_ENTITY_ID=https://your-vip-site.com/
WP_SP_ACS_URL=https://your-vip-site.com/sso/verify
WP_SP_SLO_URL=https://your-vip-site.com/sso/logout

# Only this email may authenticate (enforce in Keycloak + WP plugin)
ALLOWED_EMAIL=you@dixon.xyz

# ── Social IdPs (configure in Keycloak Admin → Identity providers) ─────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── SMTP for email OTP / magic link (Keycloak → Realm settings → Email) ────────
# KC_SMTP_HOST=
# KC_SMTP_PORT=587
# KC_SMTP_USER=
# KC_SMTP_PASSWORD=
# KC_SMTP_FROM=noreply@dixon.xyz
